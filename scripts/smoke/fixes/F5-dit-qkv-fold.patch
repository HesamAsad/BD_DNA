+      else:
+        qkv = apply_rotary_pos_emb_torchscript(
+          qkv, cos.to(qkv.dtype), sin.to(qkv.dtype))
+    return einops.rearrange(
+      qkv, '(b two) s three h d -> b (two s) three h d', two=2)
