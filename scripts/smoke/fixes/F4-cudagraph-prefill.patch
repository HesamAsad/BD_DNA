+  def _graphed_prefill_layers(self, x, block_size):
+    """CUDA-graph the 12 prefill layers, capturing forward AND backward.
+
+    WHY. At L=2048 a BiSSM step takes 258 ms while its arithmetic needs ~44,
+    and the step time is FLAT while the arithmetic quadruples to L=8192 --
+    the step is bound by the cost of ISSUING work, not doing it. The prefill
+    is 1239 of the 2132 forward dispatches and roughly two thirds of the whole
+    step once its backward is counted, so replaying it from a graph is where
+    the floor actually lives.
+
+    WHY THIS AND NOT `torch.compile`. A graph replays the same kernels with
+    the same arguments in the same order, so it is bitwise identical BY
+    CONSTRUCTION. Inductor fuses pointwise chains and keeps the intermediates
+    in fp32, which changes results in the last bits -- not allowed here.
+
+    PRECONDITIONS, all asserted below rather than assumed:
+      * static shapes -- guaranteed by a fixed `model.length` and micro batch;
+        a shape change rebuilds the graphs, which is why the cache is keyed;
+      * no RNG inside the captured region -- `model.dropout` must be 0, which
+        is what both SSM configs ship;
+      * `checkpoint_boundary_prefill` off -- checkpoint's saved-tensor hooks
+        run Python during backward and cannot be captured;
+      * Triton autotuning warmed before capture -- `make_graphed_callables`
+        runs three warmup iterations on a side stream, which is what forces
+        `mamba_chunk_scan_combined`'s autotune to settle.
+
+    KNOWN LIMITATION. A graphed callable writes its outputs into static
+    buffers that the next replay overwrites, so every micro-batch's backward
+    must run before the next micro-batch's forward. That is what Lightning
+    does under `accumulate_grad_batches`, but it is a real constraint and any
+    loop that batches several forwards before one backward will read clobbered
+    states. Refuse to enable it if that is ever configured.
+    """
+    key = (tuple(x.shape), x.dtype, block_size)
+    if self._graphed_prefill_key == key:
+      return self._graphed_prefill
+    if self._graphed_prefill is not None:
+      raise RuntimeError(
+        "graph_boundary_prefill requires a static prefill shape, but it "
+        f"changed from {self._graphed_prefill_key} to {key}. Fix the micro "
+        "batch and model.length, or set graph_boundary_prefill=false.")
+    if not x.is_cuda:
+      return None
+    shims = tuple(
+      _PrefillLayerShim(layer, block_size) for layer in self.layers)
+    samples = tuple(
+      (torch.zeros_like(x).requires_grad_(True),) for _ in shims)
+    self._graphed_prefill = torch.cuda.make_graphed_callables(shims, samples)
+    self._graphed_prefill_key = key
+    return self._graphed_prefill
+
