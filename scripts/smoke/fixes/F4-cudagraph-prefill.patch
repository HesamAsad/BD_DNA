+class _PrefillLayerShim(nn.Module):
+  """Tensor-in/tensors-out view of one prefill layer, for graph capture.
+
+  `torch.cuda.make_graphed_callables` only accepts callables whose arguments
+  are all tensors, and `scan_clean_with_boundaries` takes an int block size.
+  The shim binds it. It holds the layer by reference, so it exposes exactly the
+  same parameters and no state is duplicated.
+  """
+
+  def __init__(self, layer: "BiMambaLayer", block_size: int):
+    super().__init__()
+    self.layer = layer
+    self.block_size = int(block_size)
+
+  def forward(self, x: torch.Tensor):
+    return self.layer.scan_clean_with_boundaries(x, self.block_size)
+
